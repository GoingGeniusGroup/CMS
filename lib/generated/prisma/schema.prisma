generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isOnboarded Boolean  @default(false)

  @@map("users")
}

model Customer {
  id          String    @id @default(cuid())
  email       String    @unique
  status      String    @default("Active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  address     String?
  companyName String?
  fullName    String
  phoneNumber String?
  image       String
  serviceId   String?
  service     Service?  @relation("CustomerService", fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices    Invoice[]
  projects    Project[]

  @@index([createdAt])
  @@map("customers")
}

model Team {
  id         String    @id @default(cuid())
  role       String?
  updatedAt  DateTime  @updatedAt
  department String?
  email      String    @unique
  fullName   String
  image      String?
  joinedAt   DateTime  @default(now())
  phone      String?
  status     String    @default("Active")
  bio        String?
  location   String?
  experience String?
  skills     String[]  @default([])
  facebook   String?
  twitter    String?
  instagram  String?
  linkedin   String?
  website    String?
  blogs      Blog[]
  projects   Project[]

  @@map("teams")
}

model Service {
  id            String     @id @default(cuid())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  basePrice     Float?
  category      String?
  description   String?
  serviceDetail String?
  isActive      Boolean    @default(true)
  isFeatured    Boolean    @default(false)
  serviceName   String
  thumbnailUrl  String?
  customers     Customer[] @relation("CustomerService")
  projects      Project[]

  @@map("services")
}

model Project {
  id           String           @id @default(cuid())
  title        String
  slug         String?          @unique
  description  String?
  overview     String?
  status       String           @default("Draft")
  category     String?
  liveUrl      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  budget       Float?
  customerId   String?
  endDate      DateTime?
  serviceId    String?
  startDate    DateTime?
  teamId       String?
  thumbnail    String?
  gallery      String[]         @default([])
  features     Json?
  highlights   String[]         @default([])
  challenges   String[]         @default([])
  solutions    String[]         @default([])
  technologies String[]         @default([])
  results      Json?
  analytics    Analytics[]
  invoices     InvoiceProject[]
  customer     Customer?        @relation(fields: [customerId], references: [id])
  service      Service?         @relation(fields: [serviceId], references: [id])
  team         Team?            @relation(fields: [teamId], references: [id])

  @@index([status, createdAt])
  @@index([status, startDate, endDate])
  @@map("projects")
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     Json?
  excerpt     String?
  status      String    @default("Draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String?
  category    String?
  tags        String[]  @default([])
  readTime    String?
  publishedAt DateTime?
  thumbnail   String?
  author      Team?     @relation(fields: [authorId], references: [id])

  @@map("blogs")
}

model Invoice {
  id            String           @id @default(cuid())
  customerId    String?
  invoiceNumber String           @unique
  category      String?
  amount        Float            @default(0)
  tax           Float            @default(0)
  total         Float            @default(0)
  status        String           @default("Pending")
  issuedDate    DateTime?
  dueDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  customer      Customer?        @relation(fields: [customerId], references: [id])
  projects      InvoiceProject[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceProject {
  invoiceId String
  projectId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([invoiceId, projectId])
  @@map("invoice_projects")
}

model Analytics {
  id           String    @id @default(cuid())
  projectId    String?
  metricName   String
  metricValue  Float     @default(0)
  dimension    String?
  recordedDate DateTime?
  createdAt    DateTime  @default(now())
  project      Project?  @relation(fields: [projectId], references: [id])

  @@map("analytics")
}

model PopupSetting {
  id        String   @id @default(cuid())
  showPopup Boolean  @default(true)
  // Stored as a serialized JSON string (see app/actions/popup.ts).
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("popup_settings")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   Json?
  thumbnail String?
  metaTitle String?
  metaDesc  String?
  keywords  String?
  metaImage String?
  status    String   @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pages")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SeoSetting {
  id              String   @id @default(cuid())
  metaTitle       String   @default("")
  metaDescription String   @default("")
  metaKeywords    String   @default("")
  metaImage       String   @default("")
  updatedAt       DateTime @updatedAt

  @@map("seo_settings")
}

model AppearanceSetting {
  id           String   @id @default(cuid())
  baseColor    String   @default("#fe9a00")
  hoverColor   String   @default("#e08800")
  hoverEnabled Boolean  @default(true)
  timezone     String   @default("(GMT+05:45) Asia/Kathmandu")
  updatedAt    DateTime @updatedAt

  @@map("appearance_settings")
}

model GeneralSetting {
  id               String   @id @default(cuid())
  siteName         String   @default("")
  description      String   @default("")
  logoUrl          String   @default("")
  faviconUrl       String   @default("")
  metaKeywords     String   @default("")
  themeColor       String   @default("#6366f1")
  themeTextColor   String   @default("#ffffff")
  baseColorEnabled Boolean  @default(true)
  industryProfile  String   @default("generic")
  currency         String   @default("NPR")
  currencySymbol   String   @default("Rs.")
  dateFormat       String   @default("DD/MM/YYYY")
  numberFormat     String   @default("en-US")
  updatedAt        DateTime @updatedAt

  @@map("general_settings")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parent    String?
  order     Int      @default(0)
  banner    String?
  icon      String?
  link      String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model ContactSetting {
  id             String   @id @default(cuid())
  phone1         String   @default("")
  phone2         String   @default("")
  email1         String   @default("")
  email2         String   @default("")
  address        String   @default("")
  contactMail    String   @default("")
  officeHours    String   @default("")
  googleMapEmbed String   @default("")
  updatedAt      DateTime @updatedAt

  @@map("contact_settings")
}

model SocialSetting {
  id        String   @id @default(cuid())
  facebook  String   @default("")
  twitter   String   @default("")
  instagram String   @default("")
  linkedin  String   @default("")
  pinterest String   @default("")
  youtube   String   @default("")
  whatsapp  String   @default("")
  updatedAt DateTime @updatedAt

  @@map("social_settings")
}

model EmailSetting {
  id           String   @id @default(cuid())
  smtpHost     String   @default("")
  smtpPort     String   @default("")
  smtpUser     String   @default("")
  smtpPassword String   @default("")
  fromName     String   @default("")
  fromEmail    String   @default("")
  encryption   String   @default("tls")
  updatedAt    DateTime @updatedAt

  @@map("email_settings")
}

model SecuritySetting {
  id                String   @id @default(cuid())
  twoFactorEnabled  Boolean  @default(false)
  loginAttempts     Int      @default(5)
  sessionTimeout    Int      @default(30)
  passwordMinLength Int      @default(8)
  updatedAt         DateTime @updatedAt

  @@map("security_settings")
}

model CookieSetting {
  id                   String   @id @default(cuid())
  cookiesAgreement     Boolean  @default(true)
  showCookiesAgreement Boolean  @default(true)
  cookiesAgreementText String   @default("")
  updatedAt            DateTime @updatedAt

  @@map("cookie_settings")
}

model WebsiteHeader {
  id             String   @id @default(cuid())
  stickyHeader   Boolean  @default(true)
  bannerImageUrl String   @default("")
  bannerLink     String   @default("")
  helpNumber     String   @default("")
  menuItems      Json     @default("[]")
  updatedAt      DateTime @updatedAt

  @@map("website_headers")
}

model FooterSetting {
  id            String   @id @default(cuid())
  footerLogoUrl String   @default("")
  brandText     String   @default("Going Genius Group of Companies")
  aboutDesc     String   @default("")
  copyrightText String   @default("")
  playStoreLink String   @default("")
  appStoreLink  String   @default("")
  paymentLogos  Json     @default("[]")
  socials       Json     @default("[]")
  linkColumns   Json     @default("[]")
  updatedAt     DateTime @updatedAt

  @@map("footer_settings")
}

model Job {
  id               String      @id @default(cuid())
  title            String
  department       String      @default("")
  type             String      @default("Full-time")
  mode             String      @default("Remote")
  location         String      @default("")
  salaryRange      String      @default("")
  experience       String      @default("")
  vacanciesCount   Int         @default(1)
  deadline         DateTime?
  isActive         Boolean     @default(true)
  isFeatured       Boolean     @default(false)
  tags             String[]    @default([])
  description      String      @default("")
  responsibilities String[]    @default([])
  requirements     String[]    @default([])
  thumbnailUrl     String      @default("")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  applicants       Applicant[]

  @@map("jobs")
}

model Applicant {
  id              String   @id @default(cuid())
  jobId           String
  candidateName   String
  email           String
  phone           String   @default("")
  experienceYears String   @default("")
  currentCompany  String   @default("")
  portfolioUrl    String   @default("")
  resumeName      String   @default("")
  status          String   @default("Submitted")
  appliedDate     DateTime @default(now())
  coverNote       String   @default("")
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_applicants")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @default("")
  category  String   @default("")
  order     Int      @default(0)
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model LabelOverride {
  id        String   @id @default(cuid())
  entityKey String   @unique
  singular  String
  plural    String
  updatedAt DateTime @updatedAt

  @@map("label_overrides")
}

model CustomField {
  id           String             @id @default(cuid())
  moduleKey    String
  fieldKey     String
  label        String
  type         String             @default("text")
  options      Json?
  required     Boolean            @default(false)
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  values       CustomFieldValue[]

  @@unique([moduleKey, fieldKey])
  @@index([moduleKey, isActive, displayOrder])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String
  recordId      String
  value         Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, recordId])
  @@index([recordId])
  @@map("custom_field_values")
}

model StatusOption {
  id          String   @id @default(cuid())
  moduleKey   String
  statusValue String
  label       String
  color       String   @default("#6b7280")
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([moduleKey, statusValue])
  @@index([moduleKey, isActive, sortOrder])
  @@map("status_options")
}

// Structured, editable public-site content — one row per named section on a
// public page (e.g. pageKey "home", sectionKey "services-header"). `data` shape
// is validated against a per-sectionKey zod schema in lib/content/schemas.ts
// (SECTION_REGISTRY), never enforced at the DB level, so new section types
// don't require a migration. See Phase 16 of ORGANIZATION_AGNOSTIC_PLAN_V2.md.
model SiteContent {
  id         String   @id @default(cuid())
  pageKey    String
  sectionKey String
  variant    String   @default("default")
  isVisible  Boolean  @default(true)
  order      Int      @default(0)
  data       Json
  updatedAt  DateTime @updatedAt

  @@unique([pageKey, sectionKey])
  @@index([pageKey, isVisible, order])
  @@map("site_content")
}

// Public contact-form submissions — one row per "Send Message" on the website.
// Captured by the public submitContactLead action; managed by the admin Leads
// module. status is a free-form String driven by the configurable StatusOption
// table ("New" by default, matching the seeded "lead" status workflow).
model Lead {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  phone           String   @default("")
  company         String   @default("")
  subject         String   @default("")
  message         String   @default("")
  serviceInterest String   @default("")
  budget          String   @default("")
  status          String   @default("New")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("leads")
}
