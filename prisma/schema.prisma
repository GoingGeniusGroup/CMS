generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isOnboarded Boolean  @default(false)

  @@map("users")
}

model Customer {
  id           String    @id @default(cuid())
  image        String
  email        String    @unique
  status       String    @default("Active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  address      String?
  companyName  String?
  fullName     String
  phoneNumber  String?
    serviceId    String?
    service      Service?  @relation("CustomerService", fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices     Invoice[]
  projects     Project[]

  @@map("customers")
}

model Team {
  id         String    @id @default(cuid())
  role       String?
  updatedAt  DateTime  @updatedAt
  department String?
  email      String    @unique
  fullName   String
  image      String?
  joinedAt   DateTime  @default(now())
  phone      String?
  status     String    @default("Active")
  blogs      Blog[]
  projects   Project[]

  @@map("teams")
}

model Service {
  id           String       @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  basePrice    Float?
  category     String?
  description  String?
  isActive     Boolean    @default(true)
  serviceName  String
  thumbnailUrl String?
  customers    Customer[] @relation("CustomerService")
  projects     Project[]

  @@map("services")
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      String      @default("Draft")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  budget      Float?
  customerId  String?
  endDate     DateTime?
  serviceId   String?
  startDate   DateTime?
  teamId      String?
  thumbnail   String?
  analytics   Analytics[]
  invoices    Invoice[]
  customer    Customer?   @relation(fields: [customerId], references: [id])
  service     Service?    @relation(fields: [serviceId], references: [id])
  team        Team?       @relation(fields: [teamId], references: [id])

  @@map("projects")
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?
  status      String    @default("Draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String?
  category    String?
  publishedAt DateTime?
  thumbnail   String?
  author      Team?     @relation(fields: [authorId], references: [id])

  @@map("blogs")
}

model Invoice {
  id            String    @id @default(cuid())
  customerId    String?
  projectId     String?
  invoiceNumber String    @unique
  amount        Float     @default(0)
  tax           Float     @default(0)
  total         Float     @default(0)
  status        String    @default("Pending")
  issuedDate    DateTime?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  project       Project?  @relation(fields: [projectId], references: [id])

  @@map("invoices")
}

model Analytics {
  id           String    @id @default(cuid())
  projectId    String?
  metricName   String
  metricValue  Float     @default(0)
  dimension    String?
  recordedDate DateTime?
  createdAt    DateTime  @default(now())
  project      Project?  @relation(fields: [projectId], references: [id])

  @@map("analytics")
}

model PopupSetting {
  id        String   @id @default(cuid())
  showPopup Boolean  @default(true)
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("popup_settings")
}

model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?
  thumbnail   String?
  metaTitle   String?
  metaDesc    String?
  keywords    String?
  metaImage   String?
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SeoSetting {
  id              String   @id @default(cuid())
  metaTitle       String   @default("")
  metaDescription String   @default("")
  metaKeywords    String   @default("")
  metaImage       String   @default("")
  updatedAt       DateTime @updatedAt

  @@map("seo_settings")
}

model AppearanceSetting {
  id         String   @id @default(cuid())
  baseColor  String   @default("#825DD2")
  hoverColor String   @default("#D78539")
  timezone   String   @default("(GMT+06:45) Asia/Kathmandu")
  updatedAt  DateTime @updatedAt

  @@map("appearance_settings")
}

model GeneralSetting {
  id               String   @id @default(cuid())
  siteName         String   @default("")
  description      String   @default("")
  logoUrl          String   @default("")
  faviconUrl       String   @default("")
  metaKeywords     String   @default("")
  themeColor       String   @default("#6366f1")
  baseColorEnabled Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("general_settings")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parent    String?
  order     Int      @default(0)
  banner    String?
  icon      String?
  link      String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model ContactSetting {
  id             String   @id @default(cuid())
  phone1         String   @default("")
  phone2         String   @default("")
  email1         String   @default("")
  email2         String   @default("")
  address        String   @default("")
  contactMail    String   @default("")
  officeHours    String   @default("")
  googleMapEmbed String   @default("")
  updatedAt      DateTime @updatedAt

  @@map("contact_settings")
}

model SocialSetting {
  id        String   @id @default(cuid())
  facebook  String   @default("")
  twitter   String   @default("")
  instagram String   @default("")
  linkedin  String   @default("")
  pinterest String   @default("")
  youtube   String   @default("")
  whatsapp  String   @default("")
  updatedAt DateTime @updatedAt

  @@map("social_settings")
}

model EmailSetting {
  id           String   @id @default(cuid())
  smtpHost     String   @default("")
  smtpPort     String   @default("")
  smtpUser     String   @default("")
  smtpPassword String   @default("")
  fromName     String   @default("")
  fromEmail    String   @default("")
  encryption   String   @default("tls")
  updatedAt    DateTime @updatedAt

  @@map("email_settings")
}

model SecuritySetting {
  id                 String   @id @default(cuid())
  twoFactorEnabled   Boolean  @default(false)
  loginAttempts      Int      @default(5)
  sessionTimeout     Int      @default(30)
  passwordMinLength  Int      @default(8)
  updatedAt          DateTime @updatedAt

  @@map("security_settings")
}

model CookieSetting {
  id                   String   @id @default(cuid())
  cookiesAgreement     Boolean  @default(true)
  showCookiesAgreement Boolean  @default(true)
  cookiesAgreementText String   @default("")
  updatedAt            DateTime @updatedAt

  @@map("cookie_settings")
}
